# Server Configuration
# Server port the app listens on
PORT=4000
# Node environment: development | production | test
NODE_ENV=development

# ------------------ Database ------------------
# Postgres host
POSTGRES_HOST=
# Postgres port
POSTGRES_PORT=5432
# Postgres username
POSTGRES_USER=
# Postgres password
POSTGRES_PASSWORD=
# Postgres database name
POSTGRES_DATABASE=

# Connection pool tuning
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=300000
# How often (ms) to log pool metrics
DB_POOL_METRICS_INTERVAL_MS=30000

# ------------------ Redis ------------------
# Hostname for Redis server used for caching and rate-limits
REDIS_HOST=redis
# TCP port for Redis
REDIS_PORT=6379
# Redis auth password (if set)
REDIS_PASSWORD=
# Redis username (for ACL-enabled Redis)
REDIS_USERNAME=

# ------------------ Auth / JWT ------------------
# JWT secret used to sign authentication tokens
JWT_SECRET=

# Salt used for HMAC-SHA256 anonymization of listener IPs for unique-listener statistics (Issue #793).
# Required in production (warns in development).
# Generate with: openssl rand -hex 32
# NOTE: Rotating this secret breaks unique-listener continuity across time windows.
LISTENER_KEY_SALT=

# ------------------ Privy authentication (issues #634, #635, #636) ------------------
# Which auth path `requireAuth` accepts (see docs/PRIVY_AUTH.md):
#   legacy (default) — email/password + wallet-signature JWTs only (pre-migration / rollback)
#   both             — legacy and Privy, for a staged rollout
#   privy            — Privy only, once legacy signups have drained
# Defaults to `legacy`, so leaving this unset preserves existing behaviour exactly.
# The server refuses to start if Privy is enabled here but PRIVY_APP_ID is missing.
AUTH_MODE=legacy

# Legacy EVM wallet-signature login (/api/auth/nonce, /register, /register-listener, /login)
# and Dynamic Labs wallet routes (/api/wallet/evm/*). Off by default: they return 410 Gone.
# Set to true only to roll back; see docs/PRIVY_MIGRATION_GUIDE.md.
ENABLE_LEGACY_EVM_AUTH=false

# From the Privy dashboard (Configuration -> App settings).
# PRIVY_APP_SECRET is only needed for privileged management calls, not token
# verification — token verification uses the public JWKS and needs no secret.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=

# Issue #606: Webhook signature verification secret from Privy dashboard
# Required to verify incoming webhook signatures from Privy
PRIVY_WEBHOOK_SECRET=

# Base URL for Privy's API. The JWKS URL defaults to
#   ${PRIVY_API_URL}/v1/apps/${PRIVY_APP_ID}/.well-known/jwks.json
# Copy the exact JWKS URL from the dashboard into PRIVY_JWKS_URL if it differs;
# the path has moved between Privy SDK versions.
PRIVY_API_URL=https://auth.privy.io/api
PRIVY_JWKS_URL=

# Public signing keys are cached per process (#634). Expiry triggers a background
# refresh rather than invalidation, and a failed refresh keeps serving the last
# good set until PRIVY_JWKS_STALE_TTL_MS.
PRIVY_JWKS_TTL_MS=3600000        # 1 hour: how long a fetched key set is considered fresh
PRIVY_JWKS_STALE_TTL_MS=86400000 # 24 hours: how long a stale set may still verify
PRIVY_JWKS_NEGATIVE_TTL_MS=60000 # 1 minute: also the anti-amplification refetch cooldown

# Downtime handling (#635). Availability failures return a retryable 503, never a
# 401, so clients keep their sessions instead of being logged out by a blip.
PRIVY_REQUEST_TIMEOUT_MS=5000
PRIVY_RETRY_ATTEMPTS=3            # total attempts for transient failures
PRIVY_RETRY_BASE_DELAY_MS=200     # first backoff; doubles per attempt
PRIVY_RETRY_MAX_DELAY_MS=2000     # ceiling for a single backoff delay
PRIVY_CIRCUIT_FAILURE_THRESHOLD=5    # consecutive failures before the breaker opens
PRIVY_CIRCUIT_RESET_TIMEOUT_MS=30000 # open window before a probe is admitted
PRIVY_CIRCUIT_STARTS_OPEN=false      # set true for a cold standby replica
PRIVY_ALLOW_STALE_KEYS=true         # keep verifying with stale keys when refresh fails

# While Privy is degraded: `true` (default) keeps serving legacy-authenticated
# requests and returns 503 only for Privy tokens, preserving availability.
# `false` fails ALL auth with one uniform 503, for operators who prefer a single
# predictable behaviour during an incident.
# A rejected token (bad signature, expiry) never falls back under either setting.
PRIVY_ALLOW_LEGACY_FALLBACK=true

# ------------------ GDPR account deletion (issue #633) ------------------
# Days between a deletion request and the erasure running, during which the user
# can export their data or cancel. The erasure is irreversible.
ACCOUNT_DELETION_GRACE_PERIOD_DAYS=30
# Rate limit for /api/account/* — keyed per authenticated user, and deliberately
# tight because these endpoints are the most consequential in the account system.
ACCOUNT_LIFECYCLE_RATE_LIMIT_WINDOW_MS=3600000
ACCOUNT_LIFECYCLE_RATE_LIMIT_MAX=5

# ------------------ Soroban / Stellar ------------------
# Which Soroban network to use: testnet | mainnet
SOROBAN_NETWORK=testnet
# RPC URL for the chosen Soroban network (fallback when no per-network override below is set)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Network passphrase for Stellar/Soroban (fallback when no per-network override below is set)
SOROBAN_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# Optional per-network RPC URL / passphrase overrides
# SOROBAN_TESTNET_RPC_URL=
# SOROBAN_MAINNET_RPC_URL=
# SOROBAN_TESTNET_NETWORK_PASSPHRASE=
# SOROBAN_MAINNET_NETWORK_PASSPHRASE=
# Contract IDs — required for whichever network SOROBAN_NETWORK selects
SOROBAN_TESTNET_NFT_CONTRACT_ID=
SOROBAN_TESTNET_ARTIST_CONTRACT_ID=
SOROBAN_TESTNET_CATALOG_CONTRACT_ID=
SOROBAN_TESTNET_ROYALTY_CONTRACT_ID=
SOROBAN_TESTNET_MARKETPLACE_CONTRACT_ID=
SOROBAN_MAINNET_NFT_CONTRACT_ID=
SOROBAN_MAINNET_ARTIST_CONTRACT_ID=
SOROBAN_MAINNET_CATALOG_CONTRACT_ID=
SOROBAN_MAINNET_ROYALTY_CONTRACT_ID=
SOROBAN_MAINNET_MARKETPLACE_CONTRACT_ID=

# ------------------ Indexer Worker (Issues #233, #234, #235, #240) ------------------
# How often (ms) the worker polls each contract for new events.
INDEXER_POLL_INTERVAL_MS=15000
# Events to request per getEvents page.
INDEXER_PAGE_SIZE=200
# How often (ms) the worker recomputes the indexer_lag_ledgers metric.
INDEXER_LAG_MONITOR_INTERVAL_MS=15000
# Reorg-guard overlap / gap handling for each poll cycle.
INDEXER_OVERLAP_WINDOW=10
INDEXER_GAP_THRESHOLD=5
# Event projector (Issue #261): builds read models from raw indexed_events.
# How often (ms) the projector applies new raw events.
INDEXER_PROJECTOR_INTERVAL_MS=15000
# Raw events applied per projector transaction.
INDEXER_PROJECTOR_BATCH_SIZE=500
# Only project raw events older than this (ms), so late-committing rows are not skipped.
INDEXER_PROJECTOR_SETTLE_MS=5000

# ------------------ Twitter OAuth ------------------
# Client ID from Twitter Developer Portal (OAuth2 PKCE)
TWITTER_CLIENT_ID=
# Client secret from Twitter Developer Portal
TWITTER_CLIENT_SECRET=
# Callback URL registered with the Twitter app
TWITTER_REDIRECT_URI=http://localhost:4000/api/auth/twitter/callback
# Frontend redirect after successful Twitter link (artist dashboard)
TWITTER_SUCCESS_REDIRECT=

# ------------------ Email ------------------
# Which provider to use for transactional emails (resend, sendgrid, etc.)
EMAIL_PROVIDER=resendACT_ID=
ALBUM_FACET_TESTNET_CONTRACT_ID=
MARKETPLACE_FACET_TESTNET_CONTRACT_ID=
ROYALTY_FACET_TESTNET_CONTRACT_ID=

# Indexer configuration
INDEXER_POLL_INTERVAL_MS=5000  # Poll every 5 seconds
INDEXER_BATCH_SIZE=100         # Events per batch
INDEXER_OVERLAP_WINDOW=10      # Reorg protection window
# API key for the configured email provider
EMAIL_API_KEY=
# Default From address for outgoing emails
EMAIL_FROM=noreply@audioblocks.com

# Frontend URL for email verification and password reset links
APP_URL=http://localhost:3000

# ------------------ Rate limiting ------------------
AUTH_RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
AUTH_RATE_LIMIT_MAX=20             # max requests per window
NONCE_RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
NONCE_RATE_LIMIT_MAX=10            # max nonce requests per window

# Chunked upload endpoints (/api/song/upload/chunk, /upload/cover, /upload/finalize)
# are rate-limited per authenticated user to prevent abuse.
UPLOAD_RATE_LIMIT_WINDOW_MS=60000  # 1 minute
UPLOAD_RATE_LIMIT_MAX=10           # max requests per user per window
UPLOAD_RATE_LIMIT_ENABLED=true     # set false to bypass upload limits in CI/test environments

# Auth, nonce and password-reset limiters return 503 when Redis is down. Set true to enforce
# per-instance in-memory limits instead (limits then apply per API instance).
AUTH_RATE_LIMIT_MEMORY_FALLBACK=false

# ------------------ HLS transcoding ------------------
HLS_AUDIO_BITRATE=256k             # target AAC bitrate for streamed audio

# ------------------ Logging ------------------
# Pino log level: debug | info | warn | error  (default: info)
# Set to "debug" during local development for verbose output.
LOG_LEVEL=info
# Dedup window (ms) for error logging — repeated identical errors are suppressed within this window
ERROR_DEDUP_WINDOW_MS=300000

# ------------------ Malware scanning ------------------
SCAN_PROVIDER=clamav
CLAMAV_URL=http://clamav:9000/scan
CLAMAV_TIMEOUT_MS=30000

# ------------------ Workers / Jobs ------------------
# Maximum unacknowledged song jobs per consumer; also bounds async concurrency.
WORKER_PREFETCH=1
WORKER_MAX_ATTEMPTS=3
WORKER_BACKOFF_BASE_MS=2000
WORKER_BACKOFF_MAX_MS=30000
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_MS=2000
JOB_BACKOFF_MAX_MS=30000
JOB_COMPLETED_TTL_S=3600
JOB_QUEUE_WARN_THRESHOLD=100
JOB_MONITOR_INTERVAL_MS=30000

# ------------------ AWS / Storage ------------------
# AWS access key for S3 uploads
AWS_ACCESS_KEY_ID=
# AWS secret access key for S3
AWS_SECRET_ACCESS_KEY=
# AWS region for S3 buckets
AWS_REGION=us-east-1
# S3 bucket used to store uploaded songs and assets
AWS_BUCKET_NAME=

# ------------------ IPFS / Pinata ------------------
PINATA_JWT=
PINATA_GATEWAY=

# ------------------ Dynamic / Lisk integration ---------------
DYNAMIC_AUTH_TOKEN=
DYNAMIC_ENVIRONMENT_ID=
LISK_SEPOLIA_RPC_URL=

# ------------------ RabbitMQ (optional) ------------------
RABBITMQ_URL=
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USER=
RABBITMQ_PASS=

# ------------------ Signed URL / Manifest ------------------
SIGNED_URL_EXPIRES=300
MANIFEST_CACHE_TTL=300

# ------------------ Uploads / limits ------------------
# Max allowed bytes for a single chunk upload (used by SongRoutes)
CHUNK_UPLOAD_MAX_BYTES=8388608

# ------------------ AI (see docs/AI_FEATURES.md, docs/adrs/007-ai-integration.md) ------------------
# Concrete AI vendor behind the AiProvider interface. Only "noop" (default) is
# implemented today — any other value logs a warning and falls back to noop.
AI_PROVIDER=noop
# Per-feature kill switches, independent of each other (default: all false/off)
AI_FEATURE_TAGS_ENABLED=false
AI_FEATURE_DESCRIPTIONS_ENABLED=false
AI_FEATURE_COVER_ART_ENABLED=false
AI_FEATURE_MODERATION_TRIAGE_ENABLED=false
AI_FEATURE_SEARCH_ENABLED=false
AI_FEATURE_PLAYLISTS_ENABLED=false
AI_FEATURE_TWEET_DRAFTS_ENABLED=false
AI_FEATURE_LYRICS_TRANSCRIPTION_ENABLED=false

# ------------------ Misc ------------------
# Comma-separated list of allowed CORS origins for the API
ALLOWED_ORIGINS=

# Privy revocation lookup failures: closed (default) or open. Writes always fail on errors.
PRIVY_REVOCATION_FAILURE_MODE=closed
# Allow RabbitMQ jobs to finish before resource teardown; below the total shutdown timeout.
SHUTDOWN_DRAIN_TIMEOUT_MS=25000
