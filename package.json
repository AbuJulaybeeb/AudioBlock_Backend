{
  "name": "audioblocksbackend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --trace-warnings --transpile-only src/index.ts",
    "dev:bootstrap": "ts-node --transpile-only scripts/dev-bootstrap.ts",
    "worker": "ts-node src/workers/songWorkerMain.ts",
    "worker:indexer": "ts-node src/workers/indexer/index.ts",
    "indexer": "ts-node src/workers/indexer/index.ts",
    "cli": "ts-node src/scripts/backfill.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:changed": "jest --changedSince=main",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --runInBand tests/integration/**/*.test.ts",
    "test:watch": "jest --watch",
    "test:dynamic": "ts-node-esm src/scripts/dynamic.ts",
    "seed:genres": "ts-node src/seeders/genre.seeder.ts",
    "seed:test": "ts-node src/seeders/test.seeder.ts",
    "db:seed:test": "ts-node src/seeders/test.seeder.ts",
    "reconcile:royalties": "ts-node src/jobs/RoyaltyReconciliationJob.ts",
    "gdpr:purge-accounts": "ts-node src/jobs/AccountDeletionJob.ts",
    "reconcile:onchain": "ts-node src/jobs/OnChainReconciliationJob.ts",
    "cli:reindex": "ts-node src/cli/reindex.ts",
    "cli:project": "ts-node src/cli/project.ts",
    "migration:generate": "typeorm migration:generate",
    "migration:run": "typeorm migration:run -d dist/config/db.js",
    "migration:revert": "typeorm migration:revert -d dist/config/db.js",
    "prepare": "husky",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "deadcode": "knip",
    "deadcode:production": "knip --production",
    "compose:check": "node scripts/check-compose-consistency.js",
    "env:check": "node scripts/check-env-example.js",
    "env:check:strict": "node scripts/check-env-example.js --strict",
    "ai:test-isolation": "node scripts/check-ai-test-isolation.js",
    "benchmark:ai": "ts-node --transpile-only scripts/load-test-ai-concurrency.ts",
    "test:load:stream": "ts-node --transpile-only scripts/load-test-streaming.ts",
    "test:load:upload": "ts-node --transpile-only scripts/load-test-chunked-upload.ts"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "author": "AudioBitsStellar",
  "license": "ISC",
  "description": "The backend API for AudioBlocks, a music NFT platform on Stellar/Soroban",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.916.0",
    "@dynamic-labs-wallet/core": "^0.0.187",
    "@dynamic-labs-wallet/node-evm": "^0.0.187",
    "@stellar/stellar-sdk": "^16.0.0",
    "amqplib": "^0.10.9",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.4",
    "ioredis": "^5.6.1",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "otplib": "^13.4.1",
    "pg": "^8.16.3",
    "pinata": "^2.5.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/amqplib": "^0.10.7",
    "@types/aws-sdk": "^0.0.42",
    "@types/axios": "^0.9.36",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.14",
    "@types/pino": "^7.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^2.0.12",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "knip": "^5.45.0",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "sqlite3": "^6.0.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
